APP_NAME="School Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de données PostgreSQL (Supabase ou local) ─────────────────────────
# Pour Supabase : récupérer l'URL de connexion dans Settings → Database
# Format Supabase : host=db.<project>.supabase.co port=5432 dbname=postgres
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=school_management
DB_USERNAME=postgres
DB_PASSWORD=
# SSL requis sur Supabase — mettre "require" en production
DB_SSLMODE=prefer

# Pour Supabase (alternative via DATABASE_URL pooler Supabase) :
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Cache & Sessions ───────────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=supabase
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── Supabase Storage (S3-compatible) ──────────────────────────────────────
# 1. Dans Supabase → Storage → Créer un bucket nommé "schoolms" (public)
# 2. Dans Supabase → Settings → Storage → S3 Connection → récupérer les clés
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_S3_REGION=eu-central-1
SUPABASE_S3_BUCKET=schoolms
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_STORAGE_URL=https://<project-ref>.supabase.co/storage/v1/object/public

# ── Redis (optionnel) ──────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@schoolms.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Passerelles de paiement (sandbox par défaut) ──────────────────────────
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=

FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=

# ── OAuth Social Login (optionnel) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# ── Vite ──────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
